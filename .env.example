# Variáveis de Ambiente - InstaBytes
# Copie este arquivo para `.env` e preencha com suas chaves/valores reais.
# NÃO COMPARTILHE este arquivo com dados sensíveis no repositório!

# ========================================
# SERVIDOR
# ========================================
# Porta onde o servidor backend rodará
PORT=3000

# ========================================
# BANCO DE DADOS - MongoDB Atlas
# ========================================
# String de conexão do MongoDB Atlas
# Substitua pelos seus dados de usuário, senha e nome do cluster
# Exemplo: mongodb+srv://usuario:senha@cluster0.mongodb.net/Imersão-BackEnd?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ========================================
# INTELIGÊNCIA ARTIFICIAL - Google Gemini
# ========================================
# Chave da API do Google Generative AI (Gemini)
# Obtenha em: https://ai.google.dev
# NÃO compartilhe esta chave publicamente!
GEMINI_API_KEY=sua-chave-api-do-google-ai-aqui

# Modelo da IA a ser utilizado
# Opções: gemini-1.5-flash (rápido), gemini-2.0-flash (mais recente)
GEMINI_MODEL=gemini-2.0-flash
